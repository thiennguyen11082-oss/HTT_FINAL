# Contact form → Porkbun-hosted inbox.
# Set these in Vercel → Settings → Environment Variables. Never commit real values.

# Full mailbox address used to authenticate and send. Must be the From address
# or Porkbun will reject the message.
SMTP_USER=contact@httmarketing.com

# That mailbox's password.
SMTP_PASS=

# Where enquiries are delivered.
CONTACT_TO=contact@httmarketing.com

# Optional overrides — defaults are Porkbun's outgoing server.
# SMTP_HOST=smtp.porkbun.com
# SMTP_PORT=465
