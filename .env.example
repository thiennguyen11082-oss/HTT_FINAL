# Contact form → Porkbun-hosted inbox.
# Set these in Vercel → Settings → Environment Variables. Never commit real values.
#
# Copy this file to .env to test locally — .env is gitignored:
#   node --env-file=.env scripts/check-smtp.mjs          verify the login
#   node --env-file=.env scripts/check-smtp.mjs --send   send one real email
#
# This needs a Porkbun EMAIL HOSTING mailbox. Email Forwarding is a different
# product with no mailbox behind it, so there is nothing to authenticate as.
# Receiving is separate: the domain's MX records must point at email hosting,
# not at fwd1/fwd2.porkbun.com, or mail sent to CONTACT_TO never reaches the
# hosting inbox.

# Full mailbox address used to authenticate and send. Must be the From address
# or Porkbun will reject the message.
SMTP_USER=contact@httmarketing.com

# That mailbox's password.
SMTP_PASS=

# Where enquiries are delivered.
CONTACT_TO=contact@httmarketing.com

# Optional overrides — defaults are Porkbun's outgoing server.
# SMTP_HOST=smtp.porkbun.com
# SMTP_PORT=465
